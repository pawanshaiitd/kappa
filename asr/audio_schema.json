{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudioTranscriptionSchema",
  "type": "object",
  "properties": {
    "audio_id": {
      "type": "string"
    },
    "sample_rate_hz": {
      "type": "integer",
      "enum": [
        16000,
        22050,
        44100,
        48000
      ]
    },
    "duration_seconds": {
      "type": "number"
    },
    "transcription": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "detected_intent": {
      "type": "string"
    },
    "mapped_tool_call": {
      "type": "object",
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "tool_name",
        "arguments"
      ]
    }
  },
  "required": [
    "audio_id",
    "transcription",
    "confidence_score"
  ]
}
