+from functools import lru_cache
+from rich import inspect
+
+@lru_cache
+class Klaas:
+    __slots__ = ("__qualname__",)
+
+if __name__ == "__main__":
+    try:
+        inspect(Klaas.__qualname__)
+        inspect(Klaas, all=True)
+    except Exception as e:
+        print(f"Error: {e}")
